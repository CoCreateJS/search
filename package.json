  "bugs": {
    "url": "https://github.com/CoCreateJS/search/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/search",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/observer": "^2.0.0",
    "@cocreate/utils": "^2.0.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^2.0.0",
    "css-loader": "^5.1.3",
    "esbuild": "^0.25.2",
    "esbuild-loader": "^4.3.0",
    "mini-css-extract-plugin": "^1.5.0",
    "webpack": "^5.24.4",
    "webpack-cli": "^4.5.0",
